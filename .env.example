# Local development values. Replace secrets before deploying.
VESTIS_NETWORK=vestis-services
AUTH_PORT=8001
DB_USER=vestis
DB_PASSWORD=local-auth-database-password
SECRET_KEY=local-only-shared-jwt-secret-change-before-deployment
CODE_PEPPER=local-only-verification-pepper-change-before-deployment
ACCESS_EXPIRE_MIN=15
REFRESH_EXPIRE_DAYS=30
MAIL_STREAM=mail:outbox
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
